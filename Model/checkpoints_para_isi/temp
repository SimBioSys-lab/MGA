#!/bin/bash
# rename_files.sh

old_prefix="iPara"
new_prefix="isiPara"   # <-- change this

for f in "${old_prefix}"*; do
    # skip if no files matched the glob
    [ -e "$f" ] || { echo "No files starting with '$old_prefix' found."; break; }

    # strip the old prefix, keep the remainder (the "suffix")
    suffix="${f#$old_prefix}"
    newname="${new_prefix}${suffix}"

    echo "Renaming: $f  ->  $newname"
    mv -n -- "$f" "$newname"
done
